/* NexaTute mockups — static export shell styles (prefix dcx-) */
html.dcx-shell, html.dcx-shell body { background: #DCDFE7; }
html.dcx-shell body { margin: 0; font-family: 'Hind Siliguri', system-ui, -apple-system, 'Segoe UI', sans-serif; color: #141A33; }
.dcx-stage { box-sizing: border-box; width: max-content; min-width: 100%; padding: 18px 24px 76px; }
.dcx-frame { position: relative; margin: 0 auto; width: var(--w); height: var(--h); border-radius: var(--r, 0); overflow: hidden; background: #fff;
  box-shadow: 0 0 0 1px rgba(20, 26, 51, .06), 0 28px 64px -28px rgba(20, 26, 51, .5); }
.dcx-frame iframe { display: block; border: 0; width: 100%; height: 100%; background: transparent; }
.dcx-fixed .dcx-frame { border-radius: 6px; }
.dcx-cap { margin: 0 auto 10px; width: var(--w); max-width: 100%; font-size: 14px; line-height: 1.4; font-weight: 600; color: #434A66; text-align: center; }
.dcx-fixed .dcx-cap { text-align: start; }
@media (max-width: 437px) {
  .dcx-phone .dcx-stage { padding: 0 0 64px; }
  .dcx-phone .dcx-cap { display: none; }
  .dcx-phone .dcx-frame { border-radius: 0; box-shadow: none; }
}
a.dcx-all, a.dcx-all:visited, a.dcx-all:hover {
  position: fixed; left: 0; bottom: 12px; z-index: 2147483600; box-sizing: border-box;
  display: inline-flex; align-items: center; gap: 0; height: 34px; min-width: 24px; margin: 0; padding: 0;
  border: 0; border-radius: 0 999px 999px 0; background: rgba(20, 26, 51, .84); color: #fff !important;
  font: 600 13px/1 'Hind Siliguri', system-ui, -apple-system, 'Segoe UI', sans-serif; letter-spacing: 0;
  text-decoration: none !important; white-space: nowrap; box-shadow: 0 6px 18px -6px rgba(0, 0, 0, .4); opacity: .9;
  direction: ltr; unicode-bidi: isolate; transform: none; width: auto; overflow: hidden;
}
/* folded state is a 24px tab on the left edge, so it never sits on a board's own corner controls */
a.dcx-all .dcx-arr { display: inline-flex; flex: none; width: 24px; height: 34px; align-items: center; justify-content: center; font-size: 14px; }
/* label shows for a few seconds, then folds away; hover or keyboard focus shows it again */
a.dcx-all .dcx-lbl { display: inline-block; overflow: hidden; max-width: 0; padding-right: 0; line-height: 34px;
  transition: max-width .25s ease, padding .25s ease; animation: dcx-hint 4.5s ease both; }
@keyframes dcx-hint { 0%, 85% { max-width: 240px; padding-right: 14px; } 100% { max-width: 0; padding-right: 0; } }
a.dcx-all:hover, a.dcx-all:focus-visible { opacity: 1; background: #141A33; }
a.dcx-all:hover .dcx-lbl, a.dcx-all:focus-visible .dcx-lbl { animation: none; max-width: 240px; padding-right: 14px; }
a.dcx-all:focus-visible { outline: 3px solid #F2A93B; outline-offset: 2px; }
/* phone boards on a wide screen: plenty of room beside the phone, keep the label open */
@media (min-width: 900px) { html.dcx-phone a.dcx-all .dcx-lbl { animation: none; max-width: 240px; padding-right: 14px; } }
@media (prefers-reduced-motion: reduce) { a.dcx-all .dcx-lbl { transition: none; } }
@media print { a.dcx-all { display: none !important; } }
/* small screens: start folded so the label never sits on a board's own buttons */
@media (max-width: 599px) { a.dcx-all .dcx-lbl { animation: none; } }
